@@ -0,0 +1,40 @@
+# hydro-craft examples
+
+Runnable examples for the installed `hydro_craft` package (0.3.0). All
+inputs are seeded synthetic data from [`synthetic.py`](synthetic.py): a
+snowy catchment with four years of daily forcing and noisy synthetic
+observations, and an irrigation reservoir with dry, normal and wet
+inflow scenarios. Run any example from the repository root, for example
+`python examples/python/warming_scenarios.py`, or run all of them and
+refresh the saved outputs with `python examples/python/run_examples.py`.
+
+The optimization examples need SciPy 1.17 and fcmaes 2.1.0
+(`pip install scipy==1.17.0 fcmaes`); the application examples need
+only the package. Each example finishes in about a second on a 2-vCPU
+host. The saved outputs in [`outputs/`](outputs/) come from actual runs
+with CPython 3.12; timing lines vary from run to run.
+
+## Application examples
+
+| Example | Question | APIs | Output |
+| --- | --- | --- | --- |
+| [`catchment_sensitivity.py`](catchment_sensitivity.py) | Which catchment parameters control the fit and the water balance? One-at-a-time perturbations and Morris elementary effects. | `batch`, `score_matrix` | [txt](outputs/catchment_sensitivity.txt) |
+| [`warming_scenarios.py`](warming_scenarios.py) | How do +1, +2 and +4 degC shift peak snow, melt timing, runoff and peak discharge? | `batch` with `trace` | [txt](outputs/warming_scenarios.txt) |
+| [`reservoir_policy_study.py`](reservoir_policy_study.py) | Which release rule has the smallest worst-case regret across dry, normal and wet years? | `score_matrix(workers=2)`, `evaluate` | [txt](outputs/reservoir_policy_study.txt) |
+
+## Optimization examples
+
+| Example | Optimizer | Failure handling | Output |
+| --- | --- | --- | --- |
+| [`scipy_calibration.py`](scipy_calibration.py) | SciPy `differential_evolution(vectorized=True)`; one `score_matrix` call per generation | Search box allows `lp` up to 1.2; invalid rows get `1e3 * (1 + distance outside limits)` | [txt](outputs/scipy_calibration.txt) |
+| [`fcmaes_cmaes_population.py`](fcmaes_cmaes_population.py) | fcmaes `cmaes.Cmaes` ask/tell; each population is one `score_matrix` call with two native workers | Same graded penalty before `tell` | [txt](outputs/fcmaes_cmaes_population.txt) |
+| [`fcmaes_robust_policy.py`](fcmaes_robust_policy.py) | fcmaes `bitecpp.minimize` (BiteOpt) and `cmaescpp.minimize` on the mean cost over three scenarios | Controls searched in [0, 1.25]; invalid rows get `1e8 * (1 + distance outside [0, 1])` | [txt](outputs/fcmaes_robust_policy.txt) |
+
+## Rust
+
+[`../matrix.rs`](../matrix.rs) screens a 41 x 41 grid of reservoir rules
+plus one invalid row through `Prepared::score_matrix` and replays the
+winner as a full JSON record: `cargo run --release --example matrix`.
+Its output is in [`../outputs/matrix.txt`](../outputs/matrix.txt).
+
+See the [user manual](../../docs/user-manual.md) for the full API.
diff --git a/examples/python/catchment_sensitivity.py b/examples/python/catchment_sensitivity.py
new file mode 100644
index 0000000..c236a17
--- /dev/null
+++ b/examples/python/catchment_sensitivity.py
@@ -0,0 +1,75 @@
+"""Which catchment parameters control the fit and the water balance?
+
+Application: local and global sensitivity of a calibrated catchment.
+
+1. One-at-a-time: perturb each parameter by -25 %, -10 %, +10 % and +25 %
+   of the calibrated value and read train RMSE and test-fold volume bias
+   from full records (``Prepared.batch``).
+2. Morris elementary effects: 20 random trajectories over the plausible
+   search box, scored through ``Prepared.score_matrix`` without JSON.
+
+Run: python examples/python/catchment_sensitivity.py
+"""
+
+import random
+import statistics
+import time
+
+import synthetic as s
+from hydro_craft import Prepared
+
+model = s.calibration_case()
+prepared = Prepared(model)
+base = s.TRUTH
+reference = prepared.evaluate(base)
+assert reference["status"] == "complete", reference
+ref_test = reference["metrics"]["test"]["volume_bias_mm"]
+print(f"forcing days: {len(model['forcing'])}, model sha256: {prepared.batch([{'id': 'x', 'parameters': base}])['model_sha256'][:16]}...")
+print(f"reference train RMSE {reference['score']:.4f} mm/day, test volume bias {ref_test:.2f} mm\n")
+
+# 1. One-at-a-time perturbations, one full-record batch per parameter.
+print("One-at-a-time (train RMSE in mm/day; change of test volume bias in mm)")
+print(f"{'parameter':<12} {'-25%':>9} {'-10%':>9} {'+10%':>9} {'+25%':>9}   d(test bias) at +10%")
+for k, name in enumerate(s.NAMES):
+    candidates = []
+    for factor in (0.75, 0.9, 1.1, 1.25):
+        x = list(base)
+        lo, hi = s.LIMITS[k]
+        x[k] = min(max(x[k] * factor, lo), hi)
+        candidates.append({"id": f"{name}{factor}", "parameters": x})
+    rows = prepared.batch(candidates)["records"]
+    assert all(r["status"] == "complete" for r in rows), rows
+    rmse = " ".join(f"{r['score']:9.4f}" for r in rows)
+    shift = rows[2]["metrics"]["test"]["volume_bias_mm"] - ref_test
+    print(f"{name:<12} {rmse}   {shift:+8.2f}")
+
+# 2. Morris screening on the training RMSE.
+rng = random.Random(42)
+levels, trajectories, delta = 8, 20, 4 / 7
+dim = len(s.NAMES)
+effects = [[] for _ in range(dim)]
+start = time.perf_counter()
+calls = 0
+for _ in range(trajectories):
+    unit = [rng.randrange(levels - 4) / (levels - 1) for _ in range(dim)]
+    order = list(range(dim))
+    rng.shuffle(order)
+    points = [list(unit)]
+    for k in order:
+        unit[k] += delta
+        points.append(list(unit))
+    rows = [[lo + u * (hi - lo) for u, (lo, hi) in zip(p, s.BOUNDS, strict=True)] for p in points]
+    scores, statuses, _ = prepared.score_matrix(rows)
+    calls += len(rows)
+    assert all(status == "complete" for status in statuses), statuses
+    for step, k in enumerate(order):
+        effects[k].append((scores[step + 1] - scores[step]) / delta)
+elapsed = time.perf_counter() - start
+print(f"\nMorris elementary effects on train RMSE ({trajectories} trajectories, {calls} runs, {elapsed * 1e3:.1f} ms)")
+print(f"{'parameter':<12} {'mu*':>9} {'sigma':>9}")
+ranking = sorted(range(dim), key=lambda k: -statistics.mean(abs(e) for e in effects[k]))
+for k in ranking:
+    mu_star = statistics.mean(abs(e) for e in effects[k])
+    sigma = statistics.stdev(effects[k])
+    print(f"{s.NAMES[k]:<12} {mu_star:9.4f} {sigma:9.4f}")
+print("\nLarge mu* means influential; sigma comparable to mu* means nonlinear or interacting.")
diff --git a/examples/python/fcmaes_cmaes_population.py b/examples/python/fcmaes_cmaes_population.py
new file mode 100644
index 0000000..e0c97a8
--- /dev/null
+++ b/examples/python/fcmaes_cmaes_population.py
@@ -0,0 +1,56 @@
+"""Calibrate the catchment with fcmaes CMA-ES, one native call per generation.
+
+Optimization with fcmaes ask/tell: ``fcmaes.cmaes.Cmaes.ask`` returns a
+whole population as a 2-D NumPy array, which ``score_matrix`` evaluates
+with two native workers and without JSON. Rows that are not complete
+(here: ``lp`` above the model limit of 1.0) get a graded penalty before
+``tell``. The sampler is seeded, so the run is reproducible.
+
+Run: python examples/python/fcmaes_cmaes_population.py
+"""
+
+from collections import Counter
+import time
+
+from loguru import logger
+import numpy as np
+from scipy.optimize import Bounds
+
+from fcmaes import cmaes
+import synthetic as s
+from hydro_craft import Prepared
+
+logger.remove()
+prepared = Prepared(s.calibration_case())
+lower = [lo for lo, _ in s.BOUNDS]
+upper = [hi for _, hi in s.BOUNDS]
+upper[2] = 1.2  # lp above 1.0 is outside the model limits
+rng = np.random.default_rng(3)
+es = cmaes.Cmaes(bounds=Bounds(lower, upper), x0=[(a + b) / 2 for a, b in zip(lower, upper)],
+                 input_sigma=0.3, popsize=32, max_evaluations=8000, rg=rng,
+                 randn=lambda *shape: rng.standard_normal(shape))
+statuses_seen = Counter()
+best = (float("inf"), None)
+generations = 0
+start = time.perf_counter()
+while True:
+    xs = es.ask()
+    scores, statuses, steps = prepared.score_matrix(xs, workers=2)
+    statuses_seen.update(statuses)
+    ys = np.array(scores)
+    for i, status in enumerate(statuses):
+        if status != "complete":
+            ys[i] = 1e3 * (1.0 + s.violation(xs[i]))
+    i = int(np.argmin(ys))
+    if ys[i] < best[0]:
+        best = (float(ys[i]), xs[i].copy())
+    generations += 1
+    if es.tell(ys) != 0 or generations * es.popsize >= 8000:
+        break
+elapsed = time.perf_counter() - start
+print(f"{generations} generations of {es.popsize} in {elapsed:.2f} s; statuses {dict(statuses_seen)}")
+print(f"best train RMSE {best[0]:.5f} mm/day")
+row = prepared.evaluate(best[1].tolist())
+print("validation RMSE {:.4f}, test RMSE {:.4f} mm/day".format(
+    row["metrics"]["validation"]["rmse_mm"], row["metrics"]["test"]["rmse_mm"]))
+print("parameters:", ", ".join(f"{n}={v:.4g}" for n, v in zip(s.NAMES, best[1], strict=True)))
diff --git a/examples/python/fcmaes_robust_policy.py b/examples/python/fcmaes_robust_policy.py
new file mode 100644
index 0000000..841cb8c
--- /dev/null
+++ b/examples/python/fcmaes_robust_policy.py
@@ -0,0 +1,62 @@
+"""Find a reservoir rule that is good on average over three inflow scenarios.
+
+Optimization with standard fcmaes minimizers and failure penalties. The
+objective is the mean cost over dry, normal and wet scenarios. The search
+box is [0, 1.25] for both controls, wider than the model's [0, 1], so
+some candidates are ``invalid``; they get a penalty of 1e8 plus 1e8 times
+the distance outside [0, 1]. Each candidate is scored through
+``score_matrix([x])`` once per scenario. The same objective runs with
+BiteOpt (``fcmaes.bitecpp.minimize``) and the C++ CMA-ES
+(``fcmaes.cmaescpp.minimize``).
+
+Run: python examples/python/fcmaes_robust_policy.py
+"""
+
+from collections import Counter
+import time
+
+from loguru import logger
+import numpy as np
+from scipy.optimize import Bounds
+
+from fcmaes import bitecpp, cmaescpp
+import synthetic as s
+from hydro_craft import Prepared
+
+logger.remove()
+scenarios = [Prepared(s.reservoir(name)) for name in ("dry", "normal", "wet")]
+statuses_seen = Counter()
+
+
+def cost(x):
+    total = 0.0
+    for prepared in scenarios:
+        scores, statuses, _ = prepared.score_matrix([list(x)])
+        statuses_seen[statuses[0]] += 1
+        if statuses[0] != "complete":
+            # Same penalty for every scenario: the controls are invalid.
+            return 1e8 * (1.0 + s.violation(x, [(0.0, 1.0), (0.0, 1.0)]))
+        total += scores[0]
+    return total / len(scenarios)
+
+
+bounds = Bounds([0.0, 0.0], [1.25, 1.25])
+for name, minimize in (("bitecpp", bitecpp.minimize), ("cmaescpp", cmaescpp.minimize)):
+    statuses_seen.clear()
+    start = time.perf_counter()
+    if name == "bitecpp":
+        result = minimize(cost, bounds, x0=[1.1, 1.1], max_evaluations=600,
+                          rg=np.random.default_rng(11))
+    else:
+        result = minimize(cost, bounds, x0=[1.1, 1.1], input_sigma=0.3, popsize=16,
+                          max_evaluations=600, rg=np.random.default_rng(11))
+    elapsed = time.perf_counter() - start
+    print(f"{name}: target {result.x[0]:.4f}, gain {result.x[1]:.4f}, mean cost {result.fun:.0f}, "
+          f"{result.nfev} evaluations in {elapsed:.2f} s, scenario statuses {dict(statuses_seen)}")
+
+x = [float(v) for v in result.x]
+print(f"\n{'scenario':<8} {'cost':>11} {'shortage days':>14} {'spill m3':>12}")
+for label, prepared in zip(("dry", "normal", "wet"), scenarios, strict=True):
+    m = prepared.evaluate(x)["metrics"]
+    print(f"{label:<8} {m['shortage_m3'] + 0.05 * m['spill_m3']:11.0f} {m['shortage_days']:14d} "
+          f"{m['spill_m3']:12.0f}")
