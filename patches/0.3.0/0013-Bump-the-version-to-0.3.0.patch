From 99427c331d0e259307629b9bb2491652aadad646 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 12:05:14 -0400
Subject: [PATCH 13/18] Bump the version to 0.3.0

Update Cargo.toml, Cargo.lock and pyproject.toml. Result and request
schema tags stay at 0.1; the matrix API is not part of the JSON schema.
Exclude packages/, patches/ and dist/ from the crate and sdist so
release artifacts never nest inside packages.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Cargo.lock     | 2 +-
 Cargo.toml     | 4 +++-
 pyproject.toml | 2 +-
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 3a76ff4..debf9d2 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -64,7 +64,7 @@ checksum = "2304e00983f87ffb38b55b444b5e3b60a884b5d30c0fca7d82fe33449bbe55ea"
 
 [[package]]
 name = "hydro-craft"
-version = "0.2.0"
+version = "0.3.0"
 dependencies = [
  "pyo3",
  "serde",
diff --git a/Cargo.toml b/Cargo.toml
index 7af6855..31bbfb3 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,10 +1,12 @@
 [package]
 name = "hydro-craft"
-version = "0.2.0"
+version = "0.3.0"
 edition = "2024"
 rust-version = "1.88"
 description = "Bounded hydro-craft research evaluator"
 license = "MIT"
+# Release artifacts and patch series ship in the ZIP, not in the crate or sdist.
+exclude = ["/packages/", "/patches/", "/dist/"]
 
 [lib]
 crate-type = ["rlib", "cdylib"]
diff --git a/pyproject.toml b/pyproject.toml
index 558c29f..775d80c 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -4,7 +4,7 @@ build-backend = "maturin"
 
 [project]
 name = "hydro-craft"
-version = "0.2.0"
+version = "0.3.0"
 requires-python = ">=3.10"
 description = "Prepared hydro-craft research evaluations"
 
-- 
2.43.0

