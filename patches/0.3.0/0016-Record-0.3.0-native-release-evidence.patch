 rename evidence/{ => release-0.2.0}/performance-search.json (100%)
 rename evidence/{ => release-0.2.0}/scipy-search.json (100%)
 rename evidence/{ => release-0.2.0}/tutorial-check.json (100%)
 create mode 100644 evidence/release-0.2.0/validation.json
 create mode 100644 evidence/release-0.3.0/rust-checks.txt

