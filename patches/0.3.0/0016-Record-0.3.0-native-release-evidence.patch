 evidence/release-0.2.0/validation.json        | 102 ++++++++++++++++++
 evidence/release-0.3.0/rust-checks.txt        |  28 +++++
 14 files changed, 136 insertions(+), 3 deletions(-)
 rename evidence/{ => release-0.2.0}/campaign-replay.json (100%)
 create mode 100644 evidence/release-0.2.0/capabilities.json
 create mode 100644 evidence/release-0.2.0/cli.json
 rename evidence/{ => release-0.2.0}/installed.json (100%)
 create mode 100644 evidence/release-0.2.0/native-sweep.json
