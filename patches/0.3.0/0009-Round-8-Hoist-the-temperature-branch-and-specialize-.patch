+#[inline(always)]
+fn catchment_day<const METRICS: bool>(
+    s: &mut CatchmentState,
+    p: &CatchmentParameters,
+    d: &Day,
+) -> CatchmentFlows {
+    let before = day_start::<METRICS>(s);
+    let (liquid, recharge) = if d.temperature_c <= 0.0 {
+        freeze(s, d)
+    } else {
+        thaw::<DYNAMIC>(s, p, d)
+    };
+    day_finish::<METRICS>(s, p, d, before, liquid, recharge)
